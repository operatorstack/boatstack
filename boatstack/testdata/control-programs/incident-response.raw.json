{
  "schema_version": "control-program/v1",
  "program": {
    "id": "incident-response",
    "version": "1"
  },
  "declarations": {
    "capabilities": ["service.restart"],
    "authorities": ["incident-commander"],
    "effects": ["service.restart"],
    "verifiers": ["healthcheck"]
  },
  "facets": [
    { "id": "incident", "kind": "enum", "values": ["open", "mitigated"] },
    { "id": "service", "kind": "enum", "values": ["degraded", "healthy"] }
  ],
  "evidence": [
    { "id": "healthcheck", "subject": "service", "kind": "observation" }
  ],
  "operators": [
    {
      "id": "restart",
      "capabilities": ["service.restart"],
      "authority": ["incident-commander"],
      "effects": ["service.restart"],
      "verifier": "healthcheck",
      "recovery": "restart",
      "state_effect": {
        "kind": "assignments",
        "assignments": [{ "facet": "incident", "value": "mitigated" }]
      }
    }
  ],
  "transitions": [
    {
      "id": "restart",
      "operator": "restart",
      "guard": { "fact": { "facet": "incident", "statuses": ["known"], "values": ["open"] } },
      "target": { "fact": { "facet": "incident", "statuses": ["known"], "values": ["mitigated"] } },
      "priority": 10
    }
  ],
  "targets": [
    { "id": "mitigated", "predicate": { "fact": { "facet": "incident", "statuses": ["known"], "values": ["mitigated"] } } }
  ],
  "entries": [{ "id": "respond", "target": "mitigated", "inputs": [] }]
}
