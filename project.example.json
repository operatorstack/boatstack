{
  "schema_version": 2,
  "project": {
    "name": "example-product",
    "default_branch": "main",
    "context": [
      "README.md",
      "AGENTS.md",
      "docs/architecture/",
      "docs/decisions/"
    ],
    "commands": {
      "build": "npm run build",
      "lint": "npm run lint",
      "test": "npm test",
      "typecheck": "npm run typecheck"
    },
    "high_risk_paths": [
      "migrations/**",
      "auth/**",
      "billing/**"
    ]
  },
  "policy": {
    "plan_approval": "human",
    "independent_review_for_high_risk": true,
    "visual_evidence": "optional",
    "external_effect_authority": "human-or-autonomy-plus-provider"
  },
  "hosts": [
    "cli",
    "cursor",
    "codex",
    "claude",
    "gemini",
    "mcp",
    "sdk"
  ]
}
